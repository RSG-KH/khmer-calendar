<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/planner_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_planner_card">

    <!-- Weights use the host's measured size, so the whole animal stays inside a
         60% × 60% area after resizing without depending on widget option estimates. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">
        <TextView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="2" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="2" />
            <ImageView
                android:id="@+id/planner_animal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:scaleType="fitEnd"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingTop="8dp"
        android:paddingEnd="11dp"
        android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <!-- The slot takes only the space left by timezone and refresh; its badge wraps text. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:id="@+id/planner_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_planner_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="12.5sp" />
        </FrameLayout>
        <TextView
            android:id="@+id/planner_timezone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_planner_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:singleLine="true"
            android:textSize="12.5sp" />
        <ImageView
            android:id="@+id/planner_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_planner_action"
            android:clickable="true"
            android:foreground="@drawable/widget_planner_action_ripple"
            android:padding="7dp"
            android:src="@drawable/widget_ic_refresh"
            android:contentDescription="@string/widget_refresh" />
    </LinearLayout>

    <ListView
        android:id="@+id/planner_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:divider="@null"
        android:cacheColorHint="@android:color/transparent"
        android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
