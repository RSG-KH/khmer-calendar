<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/planner_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_planner_card"
    android:paddingStart="11dp"
    android:paddingTop="8dp"
    android:paddingEnd="11dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/planner_period"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_planner_badge"
            android:paddingHorizontal="5dp"
            android:paddingVertical="5dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/planner_timezone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_planner_badge"
            android:paddingHorizontal="5dp"
            android:paddingVertical="5dp"
            android:singleLine="true"
            android:textSize="10sp" />
        <ImageView
            android:id="@+id/planner_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_planner_badge"
            android:padding="7dp"
            android:src="@drawable/widget_ic_refresh"
            android:contentDescription="@string/widget_refresh" />
    </LinearLayout>

    <ListView
        android:id="@+id/planner_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:divider="@drawable/widget_planner_divider"
        android:dividerHeight="1dp"
        android:cacheColorHint="@android:color/transparent"
        android:scrollbars="none" />
</LinearLayout>
