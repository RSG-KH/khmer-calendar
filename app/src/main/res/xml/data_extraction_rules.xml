<?xml version="1.0" encoding="utf-8"?>
<!-- Keep user data; scheduled/delivered reminder timestamps belong to this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="reminder-state.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="reminder-state.xml" />
    </device-transfer>
</data-extraction-rules>
